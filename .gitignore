# Python runtime
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/

# Adaptive collection learning is device-local runtime state.
# Keeping these untracked prevents tablet/PC git updates from overwriting learned strategy.
collection_learning_memory.json
collection_learning_memory.json.bak
collection_learning_report.json
collection_feedback.json
collection_provider_health.json
collection_provider_health.json.bak
detailed_collection_learning.json
detailed_collection_learning.json.bak

# Live grading-cost cache is refreshed from official sources on each device.
grading_costs_cache.json
grading_proxy_costs_cache.json

# Temporary atomic-write/test artifacts
*.tmp
*.tmp.json
*.db.tmp
*.json.tmp
*.adaptive-social.tmp
*.before_photo_cleanup_*
multi_market_price_cache.json
multi_market_source_learning.json

# Device-local storage optimization status
storage_optimization_report.json
photo_cleanup_report.json

# Social stock source performance learning is device-local.
social_stock_learning.json
social_stock_learning.json.bak

# Adaptive public-search method health and optimized engine profile are device-local runtime state.
search_method_learning.json
search_method_learning.json.bak
search_engine_profile.json

# Fan/community social discovery utility learning is device-local.
fan_social_learning.json
fan_social_learning.json.bak

# Cross-collector coverage/diversity learning is device-local runtime state.
collection_meta_learning.json
collection_meta_learning.json.bak
collection_meta_profile.json

# Security-sensitive local credentials and audit state
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials*.json
secrets*.json
oauth_token*.json
security_learning_memory.json
security_audit_report.json

# Device-local manually registered slab photos and quarantine/verification state.
GRADE_TRAINING_INBOX/
manual_graded_photo_registrations.json
manual_graded_photo_registrations.json.bak

# Graphify local-only diagnostics/cache. The main graph/report may be committed deliberately.
GRAPHIFY_UPDATE.log
graphify-out/cost.json
graphify-out/cache/
