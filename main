#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"

cmd="${1:-start}"
case "$cmd" in
  start|run)
    if ! bash TABLET_SCHEDULED_UPDATE.sh ensure; then
      echo "[경고] 부팅 후 자동 main 확인 준비가 완전하지 않습니다. 현재 실행은 안전검증 후 계속하며 'bash main update-status'에서 상태를 확인하세요." >&2
    fi
    exec bash ANDROID_UPDATE_AND_START.sh
    ;;
  collect)
    exec python tablet_collection_publish_contextual.py
    ;;
  publish|send)
    exec python tablet_collection_publish_contextual.py --publish
    ;;
  verify)
    exec bash VERIFY_TABLET_FINAL.sh
    ;;
  quality)
    exec python quality_review_policy.py --check
    ;;
  evolve|autonomy)
    exec python tablet_autonomous_evolution_v381.py --execute-safe-learning --apply-capabilities --train-meta --apply-skills
    ;;
  recover)
    exec bash ANDROID_RECOVER_UPDATE.sh
    ;;
  update-install)
    exec bash TABLET_SCHEDULED_UPDATE.sh install
    ;;
  update-now)
    rc=0
    bash TABLET_SCHEDULED_UPDATE.sh run || rc=$?
    bash TABLET_SCHEDULED_UPDATE.sh ensure || true
    exit "$rc"
    ;;
  update-status)
    exec bash TABLET_SCHEDULED_UPDATE.sh status
    ;;
  update-remove)
    exec bash TABLET_SCHEDULED_UPDATE.sh remove
    ;;
  help|-h|--help)
    cat <<'EOF'
태블릿 Termux 통합 실행
  bash main            예약 업데이트 자동 준비 + 최신 main 안전검증/업데이트 후 서버 시작
  bash main collect    공개 TCG 자료 8단계 수집 + 동일 수집사이클 인지 검증(업로드 없음)
  bash main publish    최신 main에서만 수집/동일사이클 검증 후 자료 PR 생성
  bash main verify     현재 태블릿 빌드 최종 검증
  bash main quality    100 시니어 자료준비 + 1000관점(25×40) 품질정책 로컬 검증
  bash main evolve     V381 검증결과 기반 자율정책 진화: V380 100+1000 의사결정/V379 정보교환/V378 품질게이트/V377 단일실행/V376 증거장벽을 유지하고, 검증된 outcome만으로 정책 후보를 학습. champion/challenger를 표본수·승격마진으로 비교하고 시장 freshness/coverage/source-health와 정보교환 요약상태에 맞춰 최대 3개 허용형 capability recipe를 다음 회차용으로 자동 구성. 정책메모리 손상·hard blocker·충돌은 fail-closed, 시장방향 예측/사실·가격·등급 발명/임의명령/Git-main 직접수정 금지. 소스 신규기능은 비실행 proposal → protected PR/CI·전체 회귀 후에만 승격
  bash main recover         오래된 Android 업데이터 복구
  bash main update-install  현재 세션 자동루프 + 부팅 후 자동루프 설치/복구 (매일 23:00 KST 기능 업데이트 확인)
  bash main update-now      지금 최신 main 확인/안전 업데이트 후 23:00 KST 자동루프 보장
  bash main update-status   예약/다음 실행시각/실행-loop/Termux:Boot/heartbeat/마지막 업데이트 상태 표시
  bash main update-remove   예약 업데이트 제거
EOF
    ;;
  *)
    echo "[오류] 알 수 없는 명령: $cmd" >&2
    echo "사용법: bash main [start|collect|publish|verify|quality|evolve|recover|update-install|update-now|update-status|update-remove|help]" >&2
    exit 2
    ;;
esac
