#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"

cmd="${1:-start}"
case "$cmd" in
  start|run)
    if ! bash TABLET_SCHEDULED_UPDATE.sh ensure; then
      echo "[경고] 부팅 후 자동 main 확인 준비가 완전하지 않습니다. 현재 실행은 안전검증 후 계속하며 'bash main update-status'에서 상태를 확인하세요." >&2
    fi
    exec bash ANDROID_UPDATE_AND_START.sh
    ;;
  collect)
    exec python tablet_collection_publish_contextual.py
    ;;
  publish|send)
    exec python tablet_collection_publish_contextual.py --publish
    ;;
  verify)
    exec bash VERIFY_TABLET_FINAL.sh
    ;;
  audit|tablet-audit)
    python tablet_runtime_manifest.py --check --compile
    python tablet_runtime_qa.py --profile common
    exec python tablet_autonomous_evolution_v400.py --self-test
    ;;
  quality)
    exec python quality_review_policy.py --check
    ;;
  category-status)
    exec python tcg_category_autonomy.py status
    ;;
  category-review)
    exec python tcg_category_autonomy.py review --persist-registry --write-report
    ;;
  category-verify)
    exec python tcg_category_autonomy.py verify
    ;;
  evolve|autonomy)
    exec python tablet_autonomous_evolution_v400.py --domain tablet_gpt --execute-safe-learning --apply-capabilities --train-meta --apply-skills
    ;;
  recover)
    exec bash ANDROID_RECOVER_UPDATE.sh
    ;;
  update-install)
    exec bash TABLET_SCHEDULED_UPDATE.sh install
    ;;
  update-now)
    rc=0
    bash TABLET_SCHEDULED_UPDATE.sh run || rc=$?
    bash TABLET_SCHEDULED_UPDATE.sh ensure || true
    exit "$rc"
    ;;
  update-status)
    exec bash TABLET_SCHEDULED_UPDATE.sh status
    ;;
  update-remove)
    exec bash TABLET_SCHEDULED_UPDATE.sh remove
    ;;
  help|-h|--help)
    cat <<'EOF'
태블릿 Termux 통합 실행
  bash main            예약 업데이트 자동 준비 + 최신 main 안전검증/업데이트 후 서버 시작
  bash main collect    공개 TCG 자료 8단계 수집 + 동일 수집사이클 인지 검증(업로드 없음)
  bash main publish    최신 main에서만 수집/동일사이클 검증 후 자료 PR 생성
  bash main verify     현재 태블릿 빌드 최종 검증
  bash main tablet-audit 전체 태블릿 제어코드/PWA/자율진화 런타임 묶음 검사
  bash main quality    100 시니어 자료준비 + 1000관점(25×40) 품질정책 로컬 검증
  bash main category-status  현재 레지스트리 기반 활성/관찰 카테고리와 안전 게이트 상태 표시
  bash main category-review  검증된 근거만 반영하여 카테고리 상태/보고서 갱신
  bash main category-verify  카테고리 레지스트리·자율 제어 안전 게이트 검사
  bash main evolve     V400 7영역 자율진화: UI/PWA, 카드측정·등급, KR/JP/US 카드시세, 카드발급·출시, 콜라보·프로모·이벤트, 구매처·재고신호, 태블릿 제어/운영 전체를 검증 신호로 점수화. 신경망·다중후보·canary·자동 rollback을 유지하고 검증된 결손/최신성/시장활동에 따라 기존 8개 화면 카테고리 우선순위를 안전하게 조정하며 사용자가 즉시 원래 순서로 복원 가능. 전체 제어코드는 tablet_runtime_manifest 단일 목록으로 fail-closed 검증. 코드 자동생성·재작성·임의명령·Git/main 직접수정·검증우회·시장방향/가격/등급/재고/출시/행사사실 발명 금지
  bash main recover         오래된 Android 업데이터 복구
  bash main update-install  현재 세션 자동루프 + 부팅 후 자동루프 설치/복구 (매일 23:00 KST 기능 업데이트 확인)
  bash main update-now      지금 최신 main 확인/안전 업데이트 후 23:00 KST 자동루프 보장
  bash main update-status   예약/다음 실행시각/실행-loop/Termux:Boot/heartbeat/마지막 업데이트 상태 표시
  bash main update-remove   예약 업데이트 제거
EOF
    ;;
  *)
    echo "[오류] 알 수 없는 명령: $cmd" >&2
    echo "사용법: bash main [start|collect|publish|verify|tablet-audit|quality|category-status|category-review|category-verify|evolve|recover|update-install|update-now|update-status|update-remove|help]" >&2
    exit 2
    ;;
esac
