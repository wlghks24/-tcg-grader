    "separate_from_expert_review": true,
    "must_run_before_expert_review": true,
    "final_judgment_authority": false,
    "claim_external_human_team": false,
    "purpose": "Collect, clean, normalize, deduplicate, correct, supplement, and cross-validate evidence before final expert review.",
    "workflow": [
      "DISCOVER",
      "FETCH",
      "PARSE",
      "NORMALIZE",
      "DEDUP",
      "TYPO_IDENTITY_CHECK",
      "FRESHNESS_CHECK",
      "SOURCE_INDEPENDENCE_CHECK",
      "CROSSCHECK",
      "CONTRARY_EVIDENCE_CHECK",
      "CONFLICT_CHECK",
      "GAP_ANALYSIS",
      "SUPPLEMENTAL_COLLECTION",
      "PREPARED_DATASET"
    ],
    "responsibilities": [
      "official_source_collection",
      "public_market_store_social_discovery",
      "multi_region_collection",
      "normalization",
      "duplicate_removal",
      "typo_and_label_correction",
      "date_time_price_currency_place_product_identity_check",
      "source_verification",
      "source_independence_check",
      "freshness_verification",
      "contrary_evidence_search",
      "conflict_detection",
      "gap_analysis",
      "supplemental_collection",
      "cross_validation",
      "provenance_preservation"
    ],
    "completion_conditions": [
      "primary_evidence_or_data_gap_for_core_items",
      "duplicates_removed",
      "typos_and_labels_normalized",
      "dates_times_places_prices_products_crosschecked",
      "conflicts_marked",
      "gaps_received_supplemental_collection_attempt",
      "provenance_and_freshness_preserved"
    ],
    "rules": {
      "same_origin_reposts_count_as_independent_sources": false,
      "supplement_missing_data_from_independent_paths": true,
      "correct_typos_against_source": true,
      "cross_validate_all_material_facts": true,
      "preserve_provenance": true,
      "preserve_freshness": true,
      "unresolved_conflict_must_hold": true,
      "bypass_blocked_sources_allowed": false,
      "degraded_may_be_reported_as_success": false
    }
  },
