{
  "schema_version": 2,
  "policy_name": "TCG Grader 100-Senior Prep + Expert 1000 Multi-Lens Review v2",
  "description": "A mandatory 100-perspective senior data-collection preparation stage runs before the 25 x 40 = 1000-cell final review. This is a quality-control framework, not a claim that 100 or 1000 external people participate.",
  "preparation_stage": {
