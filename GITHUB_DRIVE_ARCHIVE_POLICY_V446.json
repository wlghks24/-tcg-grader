{
  "schema_version": 1,
  "version": "v446",
  "repository": "wlghks24/-tcg-grader",
  "storage_kind": "github_actions_artifacts",
  "github_plan_bytes": 524288000,
  "trigger_fraction": 0.5,
  "trigger_bytes": 262144000,
  "target_fraction": 0.4,
  "target_bytes": 209715200,
  "min_artifact_age_hours": 24,
  "keep_newest_per_name": 1,
  "max_batch_count": 25,
  "max_batch_bytes": 314572800,
  "archive_file_name_template": "github-artifact-{artifact_id}-{safe_name}.zip",
  "drive_root_name": "TCG_Grader_GitHub_Archive",
  "drive_artifacts_subdir": "artifacts",
  "drive_receipts_subdir": "receipts",
  "drive_index_subdir": "index",
  "receipt_branch": "automation/github-drive-archive",
  "receipt_path_prefix": "GITHUB_DRIVE_ARCHIVE_RECEIPTS",
  "source_repository_files_archive_allowed": false,
  "source_git_history_archive_allowed": false,
  "cache_archive_allowed": false,
  "artifact_delete_requires_verified_drive_receipt": true,
  "drive_file_id_must_not_be_published": true,
  "drive_url_must_not_be_published": true,
  "receipt_requires": {
    "drive_readback_verified": true,
    "cleanup_authorized": true,
    "transfer_completed": true
  },
  "note": "Only GitHub Actions artifacts are archived. Repository source/history remain in GitHub. Drive IDs/URLs stay private and are never written to the public receipt branch."
}
