+    def test_truncated_for_single_group_over_limit(self):
+        # A single group over the limit must report truncation, even if total <= 3*limit.
+        before={};after={f"file_{i}.py": [1, i, 0] for i in range(41)}
+        delta=differences(before,after,limit=40)
+        self.assertEqual(41,delta['count'])
+        self.assertEqual(40,len(delta['added']))
+        self.assertTrue(delta['truncated'])
+
+    def test_symlink_report_directory_is_rejected(self):
+        with tempfile.TemporaryDirectory() as td:
+            target=Path(td)/'real';target.mkdir()
+            alias=Path(td)/'alias'
+            try:alias.symlink_to(target,target_is_directory=True)
+            except (OSError, NotImplementedError):self.skipTest('symlink privileges unavailable')
+            with self.assertRaisesRegex(BundleHold, 'report_dir_symlink_forbidden'):
