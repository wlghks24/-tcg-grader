{
  "schema_version": "1.0-tablet-gpt-tcg-grader-learning-sync",
  "purpose": "explicitly synchronize Tablet GPT patch lessons into TCG Grader without exporting ChatGPT model weights or overwriting device-local learning state",
  "source_snapshot": "TCG_CROSSCHECK/TABLET_GPT/learning_snapshot.json",
  "receiver_receipt": "TCG_CROSSCHECK/TCG_GRADER/tablet_gpt_learning_receipt.json",
  "verification_test": "test_tablet_gpt_tcg_grader_sync_v289.py",
  "required_equal_fields": [
    "schema_version",
    "source_repository",
    "source_main_sha",
