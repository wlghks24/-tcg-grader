      "issue_class": "promoted_games_could_surface_without_dynamic_event_collaboration_promo_and_regional_source_gap_tracking",
      "trigger_condition": "The legacy promo collector used fixed core-game indexes, while promoted registry games could expose market/release/promo/purchase capabilities without an explicit nine-lane KR/JP/US coverage queue.",
      "prevention_rule": "For every promoted game, derive required official/news/social/publisher/event/collaboration/promo/limited-product/retailer lanes from capabilities, expand across declared KR/JP/US regions, count only verified lane-specific evidence as covered, and emit every missing cell as a collection gap.",
      "validation_required": [
        "promoted games receive all capability-required source lanes",
        "watch games are not treated as promoted collection scope",
        "official root and market URL are seeds only",
        "news/social/event/collab/promo/limited lanes stay queued until lane-specific verification",
        "missing URLs are never invented",
        "grading is never auto-enabled"
      ],
      "safety_boundary": "Coverage planning is advisory collection orchestration. It cannot invent events, URLs, profit, price direction, grading calibration, or bypass protected CI."
