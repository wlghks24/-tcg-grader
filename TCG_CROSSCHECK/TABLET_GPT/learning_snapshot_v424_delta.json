  "lessons": [
    {
      "lesson_id": "TABLET-GPT-TCG-CATEGORY-AUTONOMY-REGISTRY-V424",
      "subsystem": "tablet_tcg_category_registry_ui_v424",
      "issue_class": "verified_registry_categories_were_not_visible_across_every_tablet_market_surface",
      "trigger_condition": "The declarative registry already contained promoted and watch candidates, but purchase terms and the tablet entry surface retained a three-game fallback, leaving new verified categories disconnected from the live UI.",
      "prevention_rule": "Bind market, release, promo, analysis, trade, and purchase controls to the validated registry. Show watch candidates as read-only observation rows and keep active selectors limited to core/promoted evidence-gated rows.",
      "validation_required": [
        "tcg_game_registry.json remains the single declarative category source",
        "promoted categories reach the tablet selectors without hardcoded three-game-only terms",
        "watch candidates are visibly separated from active categories",
        "non-core categories remain grading-disabled",
        "profit guarantee, market-direction prediction, and user-behavior tracking remain false"
      ],
      "safety_boundary": "This is UI/category routing only. It does not claim that a category will be profitable, does not invent price direction, and does not promote a watch candidate without verified evidence."
    },
    {
      "lesson_id": "TABLET-GPT-TCG-AUTONOMY-CONTROLLER-GATE-V424",
      "subsystem": "tablet_tcg_autonomous_controller_v424",
      "issue_class": "scheduled_autonomy_needed_a_fail_closed_category_gate_and_bounded_extension_plan",
      "trigger_condition": "Tablet autonomy ran its existing surface evolution loop without a dedicated category-registry safety report, making category readiness and missing evidence gates less visible to the scheduled controller.",
      "prevention_rule": "Run a read-only category verification gate before autonomous evolution, expose an explicit active/watch/revalidation plan, and keep self-extension limited to declarative registry labels, aliases, regions, and evidence queues. Source feature work remains protected-PR/CI work.",
      "validation_required": [
        "tcg_category_autonomy.py status/review/verify are wired through main",
        "scheduled Termux autonomy stops safely when the category gate fails",
        "neural category activation remains disabled until 1000 independent labels",
        "source-code generation, arbitrary commands, Git writes, and verification bypass remain forbidden",
        "physical tablet and Drive results remain unclaimed until device validation"
      ],
      "safety_boundary": "The controller is an evidence router and safety gate, not an autonomous source-code writer or investment adviser. Neural output is advisory/routing-only until the existing independent-label gate is met."
    }
  ]
